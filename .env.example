IB_TRADING_MODE=paper
IB_ACCOUNT_ID=DUxxxxxxx
TWS_USERID=your_paper_username
TWS_PASSWORD=your_paper_password
VNC_SERVER_PASSWORD=pick-anything
POSTGRES_PASSWORD=pick-anything
# Free Alpaca market data keys, used only to download past prices for backtests
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Phase 4: IB client id the trading node uses. The watchdog reuses it to cancel the
# node's orders after the node is gone (IBKR only lets the same id cancel them).
IB_NODE_CLIENT_ID=11
# Phase 5: TypeSafe Jev gate key (optional; leave empty and the gate stays off)
TYPESAFE_API_KEY=
# Phase 6: phone alerts, both optional (docs/runbooks/alerts.md). ntfy: pick a long,
# hard-to-guess topic name. Telegram: the bot token from @BotFather and your chat id.
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Phase 7: paper node. ALPACA_FEED=sip needs Alpaca Algo Trader Plus; with the free plan use
# iex and PAPER_NODE_ARGS=--allow-iex (results then don't compare with the walk-forward).
ALPACA_FEED=sip
PAPER_NODE_ARGS=
